[case testCanUseExtraItemsKeywordArgumentsInTypedDictConstructor]
from typing import TypedDict

class A(TypedDict, extra_items=int):
    pass

reveal_type(A)  # N: Revealed type is "def (**builtins.int) -> TypedDict('__main__.A', {}, extra_items=builtins.int)"

B = TypedDict("B", {}, extra_items=int)
reveal_type(B)  # N: Revealed type is "def (**builtins.int) -> TypedDict('__main__.B', {}, extra_items=builtins.int)"

[builtins fixtures/dict.pyi]
[typing fixtures/typing-typeddict.pyi]

[case testTypedDictWithInvalidExtraItemsArgument]
from typing import TypedDict

class A(TypedDict, extra_items=True):  # E: Invalid type: try using Literal[True] instead?
    pass

reveal_type(A)  # N: Revealed type is "def (**Any) -> TypedDict('__main__.A', {}, extra_items=Any)"

B = TypedDict("B", {}, extra_items=46)  # E: Invalid type: try using Literal[46] instead?
reveal_type(B)  # N: Revealed type is "def (**Any) -> TypedDict('__main__.B', {}, extra_items=Any)"
[builtins fixtures/dict.pyi]
[typing fixtures/typing-typeddict.pyi]

[case testTypedDictIndexingWithExtraItems]
from typing import TypedDict, Literal

class A(TypedDict, extra_items=bool):
    name: str

a: A
key: Literal['extra', 'name']
key2: Literal['extra1', 'extra2']
reveal_type(a['extra'])  # N: Revealed type is "builtins.bool"
reveal_type(a[key])  # N: Revealed type is "Union[builtins.bool, builtins.str]"
reveal_type(a[key2])  # N: Revealed type is "builtins.bool"

reveal_type(a.get('extra'))  # N: Revealed type is "Union[builtins.bool, None]"
reveal_type(a.get(key))  # N: Revealed type is "Union[builtins.bool, builtins.str, None]"
reveal_type(a.get(key2))  # N: Revealed type is "Union[builtins.bool, None]"
[builtins fixtures/dict.pyi]
[typing fixtures/typing-typeddict.pyi]

[case testTypedDictCreationWithExtraItems]
from typing import TypedDict, Union

class Movie(TypedDict, extra_items=Union[bool, str]):
    name: str

a: Movie = {"name": "Blade Runner", "novel_adaptation": True}
a2 = Movie(name="Blade Runner", novel_adaptation=True)

b: Movie = {"name": "Blade Runner", "year": 1982}  # E: Incompatible types (expression has type "int", TypedDict item "year" has type "Union[bool, str]")
b2 = Movie(name="Blade Runner", year=1982)  # E: Incompatible types (expression has type "int", TypedDict item "year" has type "Union[bool, str]")

c: Movie = {"name": "Blade Runner"}
c2 = Movie(name="Blade Runner")

director: Union[str, bool] = "Ridley Scott"
d: Movie = {"name": "Blade Runner", "director": director}
d2 = Movie(name="Blade Runner", director=director)
[builtins fixtures/dict.pyi]
[typing fixtures/typing-typeddict.pyi]

[case testTypedDictExtraItemDel]
from typing import TypedDict

class Movie(TypedDict, extra_items=str):
    pass

movie: Movie
del movie["extra_item"]
[builtins fixtures/dict.pyi]
[typing fixtures/typing-typeddict.pyi]

[case testTypedDictExtraItemsPopMethod]
from typing import TypedDict, NotRequired

class Movie(TypedDict, extra_items=str):
    pass

movie: Movie

reveal_type(movie.pop("extra_item"))  # N: Revealed type is "builtins.str"
reveal_type(movie.pop("extra_item", default=''))  # N: Revealed type is "builtins.str"
reveal_type(movie.pop("extra_item", default=23))  # N: Revealed type is "Union[builtins.str, Literal[23]?]"
[typing fixtures/typing-typeddict.pyi]
