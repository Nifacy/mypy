[case testUnableToDeleteReadOnlyExtraItem]
from typing_extensions import TypedDict
from typing import ReadOnly

class Movie(TypedDict, extra_items=ReadOnly[str]):
    pass

movie: Movie
del movie["extra_item"]  # E: Key "extra_item" of TypedDict "Movie" cannot be deleted
