[case testCanUseExtraItemsKeywordArgumentsInTypedDictConstructor]
from typing import TypedDict

class A(TypedDict, extra_items=int):  # N: 'extra_items' is not supported for now
    pass

B = TypedDict("B", {}, extra_items=int)  # N: 'extra_items' is not supported for now
